# Copy this file to `.env` (in the repo root when running `go run ./cmd/server`,
# or next to the built binary) and fill in the values you need. See
# CLAUDE.md's "Configuration" section for the full dotenv load order.
#
# At least one webhook URL (Discord and/or Google Chat) should be set per
# event category you want notifications for; leaving a category's URL(s)
# blank simply disables notifications for that category/destination.

# Application environment: development, production, or test
APP_ENV=development

# Gin mode: debug, release, or test (leave blank to use gin's default)
GIN_MODE=debug

# Discord incoming webhook URLs, one per event category (optional)
DISCORD_PR_URL=https://discord.com/api/webhooks/your-pr-webhook
DISCORD_PIPELINE_URL=https://discord.com/api/webhooks/your-pipeline-webhook
DISCORD_RELEASE_URL=https://discord.com/api/webhooks/your-release-webhook

# Google Chat incoming webhook URLs, one per event category (optional)
GOOGLE_CHAT_PR_URL=https://chat.googleapis.com/v1/spaces/your-space/messages?key=...&token=...
GOOGLE_CHAT_PIPELINE_URL=https://chat.googleapis.com/v1/spaces/your-space/messages?key=...&token=...
GOOGLE_CHAT_RELEASE_URL=https://chat.googleapis.com/v1/spaces/your-space/messages?key=...&token=...

# Azure DevOps REST API access, used by the pipeline route to resolve the
# triggering repository name (Personal Access Token needs Code: Read)
AZURE_ORGANIZATION=https://dev.azure.com/your-organization
AZURE_PROJECT=your-project
AZURE_PAT_TOKEN=your-personal-access-token

# This service's own externally reachable base URL, e.g.
# https://notify.example.com (optional). When set, user avatars in
# notifications are rewritten to point back at this service, which fetches
# them from Azure DevOps with the PAT above and serves them on
# /avatar/<ref>. Azure's own image URLs require authentication, so without
# this the chat apps show a blank avatar. The URL must be reachable by
# Discord / Google Chat, not just by Azure DevOps; leave it blank to keep
# using Azure's raw image URLs.
PUBLIC_BASE_URL=

# Port the server listens on (optional, defaults to 8080)
# PORT=8080
